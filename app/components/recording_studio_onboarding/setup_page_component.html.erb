<%= render FlatPack::Stack::Component.new(gap: :lg, data: { testid: "your-setup" }) do %>
  <% if heading? %>
    <%= render FlatPack::PageTitle::Component.new(title: title, subtitle: subtitle, variant: :h1) %>
  <% end %>

  <% if status.applicable? && status.remaining.empty? %>
    <p>Nothing left. Nice work.</p>
  <% elsif status.applicable? %>
    <%= render FlatPack::List::Component.new(
          divider: true,
          class: "w-full overflow-hidden rounded-[var(--radius-lg)] border border-[var(--surface-border-color)] bg-[var(--surface-background-color)]",
          data: { testid: "setup-remaining" }
        ) do %>
      <% status.remaining.each do |item| %>
        <%= render FlatPack::List::Item.new(
              icon: item.icon,
              title: item.next_step,
              href: item.link.presence,
              hover: true,
              align: :center,
              trailing: row_chevron,
              data: { testid: "setup-item-#{item.key}" }
            ) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
