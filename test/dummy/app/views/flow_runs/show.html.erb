<% dummy_page_nav(title: "Flow run", back_url: flows_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @run.flow_key.to_s,
    subtitle: "Status #{@run.status} · step #{@run.current_step_key} · version #{@run.flow_version}",
    variant: :h1
  ) %>

  <p class="text-sm leading-6" data-testid="run-progress">
    Progress <%= (@run.progress_ratio * 100).round %>% ·
    scope <%= @run.scope_type %> ·
    dismissible=<%= @definition&.dismissible %>
  </p>

  <% if @run.open? %>
    <div class="flex flex-wrap gap-3 text-sm" data-testid="run-controls">
      <%= button_to "Advance",
            advance_flow_run_path(@run, from: @run.current_step_key),
            method: :post,
            class: "underline" %>
      <%= button_to "Back",
            back_flow_run_path(@run, from: @run.current_step_key),
            method: :post,
            class: "underline" %>
      <%= button_to "Skip",
            skip_flow_run_path(@run, from: @run.current_step_key),
            method: :post,
            class: "underline" %>
      <%= button_to "Dismiss",
            dismiss_flow_run_path(@run),
            method: :post,
            class: "underline" %>
    </div>
  <% end %>

  <%= button_to "Reset run",
        reset_flow_run_path(@run),
        method: :post,
        class: "text-sm underline" %>

  <section class="flex flex-col gap-2">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Step progress",
      variant: :h2
    ) %>
    <ul class="space-y-2 text-sm leading-6" data-testid="step-progress-list">
      <% @steps.each do |step| %>
        <li data-testid="step-<%= step.step_key %>">
          <strong><%= step.step_key %></strong> — <%= step.status %>
          <% if step.first_viewed_at %>
            · viewed <%= step.first_viewed_at %>
          <% end %>
          <% if step.acted_at %>
            · acted <%= step.acted_at %>
          <% end %>
          <% if @run.current_step_key == step.step_key %>
            <em>(current)</em>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
</div>
