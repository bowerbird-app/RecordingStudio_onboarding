<% dummy_page_nav(title: "Flows", back_url: root_path) %>

<div class="flex w-full flex-col gap-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Onboarding flows",
    subtitle: "PR 2 demo: registered flows, start a run, inspect progress. Card UI arrives in PR 3.",
    variant: :h1
  ) %>

  <section class="flex flex-col gap-3" data-testid="registered-flows">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Registered flows",
      subtitle: "Ruby configuration from RecordingStudioOnboarding.configure.",
      variant: :h2
    ) %>
    <ul class="space-y-3 text-sm leading-6">
      <% @flows.each do |flow| %>
        <li data-testid="flow-<%= flow.key %>">
          <strong><%= flow.key %></strong>
          — scope <%= flow.scope %>,
          version <%= flow.version %>,
          <%= flow.steps.size %> steps,
          dismissible=<%= flow.dismissible %>
          <div class="mt-2">
            <% if flow.scope == :user %>
              <%= button_to "Start #{flow.key}",
                    start_flows_path(flow_key: flow.key),
                    method: :post,
                    class: "underline" %>
            <% elsif flow.scope == :workspace && @workspaces.any? %>
              <% @workspaces.first(3).each do |workspace| %>
                <%= button_to "Start on #{workspace.name}",
                      start_flows_path(
                        flow_key: flow.key,
                        scope_type: "Workspace",
                        scope_id: workspace.id
                      ),
                      method: :post,
                      class: "mr-3 underline" %>
              <% end %>
            <% elsif flow.scope == :subject && @pages.any? %>
              <% @pages.first(3).each do |page| %>
                <%= button_to "Start on #{page.title}",
                      start_flows_path(
                        flow_key: flow.key,
                        scope_type: "Page",
                        scope_id: page.id
                      ),
                      method: :post,
                      class: "mr-3 underline" %>
              <% end %>
            <% else %>
              <span class="opacity-70">No subject available to start this flow.</span>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="flex flex-col gap-3" data-testid="flow-runs">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Recent runs",
      subtitle: "FlowRun records for this actor or user-scoped subject.",
      variant: :h2
    ) %>
    <% if @runs.any? %>
      <ul class="space-y-2 text-sm leading-6">
        <% @runs.each do |run| %>
          <li data-testid="flow-run">
            <%= link_to "#{run.flow_key} · #{run.status} · step #{run.current_step_key}",
                  flow_run_path(run),
                  class: "underline" %>
            <span class="opacity-70">
              scope <%= run.scope_type %>/<%= run.scope_id.to_s.first(8) %>
              · v<%= run.flow_version %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm leading-6">No runs yet. Start a flow above.</p>
    <% end %>
  </section>
</div>
