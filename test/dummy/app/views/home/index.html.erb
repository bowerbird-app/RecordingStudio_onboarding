<% dummy_page_nav(title: "Onboarding Demo", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recording Studio Onboarding",
    subtitle: "Provisioning plus named flow runs (card UI arrives in PR 3).",
    variant: :h1
  ) %>

  <div class="flex flex-col gap-4 text-sm leading-6">
    <p>
      New accounts created through Devise registration call
      <code>RecordingStudioOnboarding.provision(:new_registration, …)</code>.
      The host provisioner creates a Workspace root and grants owner access via
      Recording Studio Accessible. Signing in as an existing user does not re-provision.
    </p>

    <p>
      Named flows live in Ruby configuration. Start a run with
      <code>RecordingStudioOnboarding.start</code>; advance, skip, dismiss, and reset
      go through the public API without rendering UI in the gem itself.
    </p>

    <p>
      <%= link_to "View flows and runs", flows_path, class: "underline" %>
      ·
      <%= link_to "View provisioning status", provisioning_path, class: "underline" %>
      ·
      <%= link_to "Create an account", new_user_registration_path, class: "underline" %>
      ·
      <%= link_to "Sign in", new_user_session_path, class: "underline" %>
    </p>
  </div>
</div>
