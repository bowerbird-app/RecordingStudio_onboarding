<% dummy_page_nav(title: "Onboarding Demo", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recording Studio Onboarding",
    subtitle: "Provisioning, flows, and Flatpack card shell (admin arrives in PR 4).",
    variant: :h1
  ) %>

  <div class="flex flex-col gap-4 text-sm leading-6">
    <p>
      New accounts provision from RecordingStudio_users
      <code>registration.completed.recording_studio_user</code>
      (password, OAuth, and OTP). Named flows start with
      <code>RecordingStudioOnboarding.start</code>; presentation is full-screen
      (<code>/onboarding/runs/:uuid</code>) or embedded via
      <code>RunComponent</code>.
    </p>

    <p>
      <%= link_to "View flows and runs", flows_path, class: "underline" %>
      ·
      <%= link_to "View provisioning status", provisioning_path, class: "underline" %>
      ·
      <%= link_to "Create an account", new_user_registration_path, class: "underline" %>
      ·
      <%= link_to "Sign in", new_user_session_path, class: "underline" %>
    </p>
  </div>
</div>
